# Copy to .env and adjust. Every value is optional; these are the defaults.

# Port the API listens on.
PORT=4000

# Browser origins allowed to call the API, comma-separated. Use * to allow any origin.
CORS_ORIGIN=http://localhost:3000

# Timeout for each request made to YouTube, in milliseconds.
YOUTUBE_TIMEOUT_MS=15000

# Requests allowed per client IP per minute on /api/transcript and /api/export.
RATE_LIMIT_PER_MINUTE=30

# Number of reverse proxies in front of the API (0 = none). Needed for correct
# client IPs, and therefore rate limiting, behind a load balancer.
TRUST_PROXY=0

# Where captions come from:
#   auto     (default) directly from YouTube; through Supadata when YouTube refuses
#            this server with its bot check and SUPADATA_API_KEY is set.
#   youtube  only directly from YouTube (fine on a home network).
#   supadata only through the Supadata transcript API (recommended on Vercel and
#            other cloud hosts, which YouTube often refuses).
TRANSCRIPT_PROVIDER=auto

# API key from https://supadata.ai (dashboard). Server-side only; never commit it.
# SUPADATA_API_KEY=

# Longest wait for the transcript service, including large videos processed as a job.
TRANSCRIPT_SERVICE_TIMEOUT_MS=60000

# Largest request body accepted by the PDF export endpoint.
EXPORT_BODY_LIMIT=8mb

# Versions of the YouTube app clients the API identifies as. Only change these
# if YouTube starts rejecting requests and a newer app version is known to work.
# YT_ANDROID_CLIENT_VERSION=20.10.38
# YT_IOS_CLIENT_VERSION=20.10.4
