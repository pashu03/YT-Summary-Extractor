{
  "name": "yt-transcript-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that extracts YouTube captions and builds extractive NLP summaries. No database, no AI APIs.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "pdfkit": "^0.20.2",
    "stemmer": "^2.0.1",
    "stopwords-iso": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
